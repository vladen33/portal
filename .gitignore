# Виртуальное окружение (по правилам проекта — venv, не .venv)
venv/

# Секреты и локальные настройки
.env

# База данных SQLite (режим разработки)
db.sqlite3

# Загруженные файлы и собранная статика
media/
staticfiles/

# Кэши Python и инструментов
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Логи
*.log

# Настройки локальной IDE
.vscode/
