# Пример локальных настроек. Скопируйте в .env и заполните своими значениями.
# Файл .env в репозиторий не попадает (см. .gitignore).

# Секретный ключ Django. Сгенерировать можно так:
#   venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Профиль БД: sqlite (разработка) или mssql (проверка на MS SQL Server).
DB_ENGINE=sqlite

# Параметры MS SQL Server, нужны только при DB_ENGINE=mssql.
DB_NAME=portal
DB_USER=portal
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=1433
# True — не проверять сертификат сервера (контейнер MSSQL с
# самоподписанным сертификатом), False — проверять (внешний сервер).
DB_TRUST_CERT=True
# Сколько секунд переиспользовать соединение с базой (0 — без кеша).
DB_CONN_MAX_AGE=60
# Режим установки: docker (контейнер здесь) или external (сервер в сети).
DEPLOY_DB_MODE=docker

# Пароль SA для контейнера MS SQL Server (deploy/docker-compose.mssql.yml).
# Не короче 8 символов: заглавные, строчные, цифры и спецсимвол.
# Приложение под sa не работает: DB_USER/DB_PASSWORD — отдельный логин.
MSSQL_SA_PASSWORD=change-me
MSSQL_HOST_PORT=1433

# Вход через Active Directory (по умолчанию выключен).
AD_ENABLED=False
# Только шифрованный канал: ldaps://dc1.example.local:636
# либо ldap://dc1.example.local:389 вместе с AD_USE_STARTTLS=True.
AD_SERVER_URI=ldaps://dc1.example.local:636
AD_USE_STARTTLS=False
# PEM-файл корпоративного корневого сертификата.
AD_CA_CERT_FILE=/etc/ssl/certs/corp-root-ca.pem
AD_TLS_VERIFY=True
# Сервисная учётка для поиска сотрудников в каталоге.
AD_BIND_DN=CN=portal-service,OU=Service,DC=example,DC=local
AD_BIND_PASSWORD=change-me
AD_USER_SEARCH_BASE=OU=Users,DC=example,DC=local
# Доменная группа, члены которой допускаются на портал (CN группы).
AD_REQUIRED_GROUP=GG-PORTAL-USERS
# Группа Django с начальными правами доменных пользователей.
AD_DEFAULT_GROUP=Пользователи портала
AD_SYNC_ATTRIBUTES=True

# --- Production-контур ------------------------------------------------------
# Все параметры ниже нужны только на сервере; локально оставьте
# значения по умолчанию (DEBUG=True).

# Django стоит за nginx и узнаёт про HTTPS из X-Forwarded-Proto.
DJANGO_USE_PROXY_TLS=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# С самоподписанным сертификатом HSTS выключаем (0): иначе браузер
# не даст обойти предупреждение. Включать после корпоративного УЦ.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.local
# Включайте только если все поддомены домена тоже работают по HTTPS:
# иначе `manage.py check --deploy` оставит предупреждения W005/W021.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Каталоги вне web-root nginx: файлы отдают вьюхи приложений.
DJANGO_MEDIA_ROOT=/var/lib/portal/media
DJANGO_STATIC_ROOT=/srv/portal/staticfiles

# Журнал Django: каталог принадлежит пользователю портала.
DJANGO_LOG_DIR=/var/log/portal
DJANGO_LOG_LEVEL=INFO

# Параметры gunicorn (по умолчанию 2 воркера на ядро + 1).
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_TIMEOUT=60
GUNICORN_LOGLEVEL=info
