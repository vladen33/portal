# Настройки production-портала.
# Файл создан deploy/install.sh. Правки допустимы, но повторная
# установка с --force-env перезапишет файл.

DJANGO_SECRET_KEY=@SECRET_KEY@
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=@ALLOWED_HOSTS@

# --- MS SQL Server ----------------------------------------------------------
DB_ENGINE=mssql
DB_NAME=@DB_NAME@
DB_USER=@DB_USER@
DB_PASSWORD=@DB_PASSWORD@
DB_HOST=@DB_HOST@
DB_PORT=@DB_PORT@
# False — сертификат внешнего сервера проверяется (production).
# True — только для контейнера MSSQL с самоподписанным сертификатом.
DB_TRUST_CERT=@DB_TRUST_CERT@
DB_CONN_MAX_AGE=60
# Режим установки: docker (контейнер здесь) или external (сервер в сети).
DEPLOY_DB_MODE=@DB_MODE@

# --- HTTP/TLS ---------------------------------------------------------------
DJANGO_USE_PROXY_TLS=@USE_PROXY_TLS@
DJANGO_SECURE_SSL_REDIRECT=@SSL_REDIRECT@
DJANGO_SESSION_COOKIE_SECURE=@COOKIE_SECURE@
DJANGO_CSRF_COOKIE_SECURE=@COOKIE_SECURE@
# 0 при самоподписанном сертификате: HSTS не даёт обойти предупреждение.
# 31536000 включать после перехода на сертификат корпоративного УЦ.
DJANGO_SECURE_HSTS_SECONDS=@HSTS_SECONDS@
DJANGO_CSRF_TRUSTED_ORIGINS=@CSRF_ORIGINS@

# --- Пути -------------------------------------------------------------------
DJANGO_MEDIA_ROOT=@MEDIA_ROOT@
DJANGO_STATIC_ROOT=@APP_DIR@/staticfiles
# Журнал Django: каталог принадлежит пользователю портала.
DJANGO_LOG_DIR=@LOG_DIR@
DJANGO_LOG_LEVEL=INFO

# --- gunicorn ---------------------------------------------------------------
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_TIMEOUT=60
GUNICORN_LOGLEVEL=info

# --- Контейнер MSSQL (только при --db=docker) -------------------------------
MSSQL_SA_PASSWORD=@SA_PASSWORD@
MSSQL_HOST_PORT=@MSSQL_HOST_PORT@

# --- Active Directory -------------------------------------------------------
# Вход через AD выключен. После установки заполните параметры домена
# и поставьте AD_ENABLED=True (см. README, раздел про Active Directory).
AD_ENABLED=False
AD_SERVER_URI=
AD_USE_STARTTLS=False
AD_CA_CERT_FILE=
AD_TLS_VERIFY=True
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_USER_SEARCH_BASE=
AD_REQUIRED_GROUP=
AD_DEFAULT_GROUP=Пользователи портала
AD_SYNC_ATTRIBUTES=True
